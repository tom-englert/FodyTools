<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>Enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Binaries\*.*" />
    <None Remove="*.received.txt" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Binaries\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FodyHelpers" Version="6.9.3" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="TomsToolbox.Essentials" Version="2.26.1" />
    <PackageReference Include="Verify" Version="33.3.0" />
    <PackageReference Include="Verify.XunitV3" Version="33.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DummyAssembly\DummyAssembly.csproj" />
    <ProjectReference Include="..\DummyNullableAssembly\DummyNullableAssembly.csproj" />
    <ProjectReference Include="..\EmptyAssembly\EmptyAssembly.csproj" />
    <ProjectReference Include="..\FodyTools\FodyTools.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net472'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="WindowsBase" />
    <ProjectReference Include="..\ShellAssembly\ShellAssembly.csproj" />
  </ItemGroup>
</Project>